{
  "name": "aura-mobility-ecosystem",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json",
    "preflight": "vite-node scripts/preflight.ts --",
    "test:e2e": "vitest run tests/e2e",
    "verify": "npm run typecheck && npm run typecheck:functions && npm test && npm run build && npm run preflight",
    "build:share": "vite build -c vite.share.config.ts",
    "e2e:ui": "node scripts/e2e-ui-trip.cjs",
    "e2e:beta-payments": "node scripts/e2e-beta-payments.cjs",
    "check:bundle-env": "node scripts/check-bundle-env.cjs",
    "e2e:demo-isolation": "node scripts/e2e-demo-isolation.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/readex-pro": "^5.2.0",
    "@supabase/supabase-js": "2.119.0",
    "framer-motion": "^14.14.0",
    "mapbox-gl": "^3.12.0",
    "lucide-react": "^1.79.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-postgis": "0.2.15",
    "@tailwindcss/vite": "^4.3.5",
    "@types/google.maps": "3.66.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
