# ============================================================================
# AURA — environment template
# Copy to `.env.local` for the web app. Server secrets go to Supabase:
#   npx supabase secrets set --env-file ./supabase/.env   (never commit real values)
#
# RULE: anything prefixed VITE_ is bundled into the browser. Only public,
#       restricted keys may use it. Secrets must NEVER have a VITE_ prefix.
# Every provider has a `mock` mode so the app runs end-to-end without keys.
# ============================================================================

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
VITE_APP_ENV=development
VITE_DEFAULT_CITY=riyadh
VITE_DEFAULT_LOCALE=ar                    # ar | en

# ── Supabase ────────────────────────────────────────────────────────────────
# Public (browser): Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Server only (Edge Functions / CI). Bypasses RLS — never expose.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=
# Must match Auth → Providers → Phone → OTP length (demo mode uses 4-digit codes)
VITE_AUTH_OTP_LENGTH=6

# ── Maps ────────────────────────────────────────────────────────────────────
VITE_MAPS_PROVIDER=mock                   # mock (built-in CityMap) | google
# Browser key: restrict to your domains + Maps JavaScript API / Places API
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Server key: restrict to Routes API (used by the request-ride Edge Function).
# Without it, prices use a straight-line estimate (road factor 1.3, 30 km/h).
GOOGLE_MAPS_SERVER_KEY=

# ── Dispatch ────────────────────────────────────────────────────────────────
# Only needed when pg_cron is not enabled: shared secret for the dispatch-tick Edge Function
DISPATCH_CRON_SECRET=

# ── Payments ────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock                     # mock | moyasar | hyperpay
VITE_PAYMENT_PROVIDER=mock
# Moyasar (dashboard.moyasar.com → Settings → API keys). Local development only: staging / BETA /
# Vercel Preview are mock-only and refuse any Moyasar value (preflight, build, browser and Edge guards).
# The browser uses Moyasar only with VITE_PAYMENT_PROVIDER=moyasar AND a publishable key.
VITE_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
# Where the bank returns the rider after 3-D Secure (the app reads ?payment=<id>)
PAYMENT_CALLBACK_URL=http://localhost:5180/#/passenger
# Shared secret for the payments-worker Edge Function (capture/void/refund scheduler)
PAYMENTS_CRON_SECRET=
# Apple Pay via Moyasar (merchant id from Apple Developer)
VITE_APPLE_PAY_MERCHANT_ID=
# HyperPay (optional second provider; same PaymentProvider interface)
HYPERPAY_API_BASE_URL=https://eu-test.oppwa.com
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID_CARD=
HYPERPAY_ENTITY_ID_MADA=
HYPERPAY_ENTITY_ID_APPLEPAY=
HYPERPAY_WEBHOOK_SECRET=

# ── Captain payouts ─────────────────────────────────────────────────────────
PAYOUT_PROVIDER=mock                      # mock | moyasar | hyperpay | bank | lean
PAYOUT_API_BASE_URL=
PAYOUT_API_KEY=
PAYOUT_WEBHOOK_SECRET=
PAYOUT_SOURCE_IBAN=

# ── Wasl (TGA / Elm) — field names to confirm against the official contract ──
WASL_MODE=mock                            # mock | live
WASL_API_BASE_URL=
WASL_CLIENT_ID=
WASL_APP_ID=
WASL_APP_KEY=
WASL_OPERATOR_ID=
# Optional endpoint paths (defaults are placeholders: align with the Elm specification)
WASL_PATH_DRIVER_REGISTRATION=
WASL_PATH_VEHICLE_REGISTRATION=
WASL_PATH_ELIGIBILITY_CHECK=
WASL_PATH_TRIP_REGISTRATION=
WASL_PATH_TRIP_UPDATE=
# Shared secrets for the scheduled workers
WASL_CRON_SECRET=
PRIVACY_CRON_SECRET=
# Health endpoint: secret for detailed output; version string reported to monitors
HEALTH_SECRET=
AURA_VERSION=

# ── SMS / OTP (configured in Supabase Auth → Phone provider) ─────────────────
SMS_PROVIDER=mock                         # mock | unifonic | taqnyat | twilio
SMS_API_KEY=
SMS_SENDER_ID=

# ── Push notifications ──────────────────────────────────────────────────────
PUSH_PROVIDER=mock                        # mock | fcm | expo
FCM_SERVICE_ACCOUNT_JSON=
EXPO_ACCESS_TOKEN=

# ── Business defaults (authoritative values live in the `tariffs` table) ─────
VAT_RATE_BPS=1500
CURRENCY=SAR
