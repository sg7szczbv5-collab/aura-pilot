# ============================================================================
# AURA — BETA (field test) environment template.  See docs/beta/BETA_READINESS.md
#
# BETA runs on its OWN Supabase project (not aura-nexus-prod) and its own Vercel
# environment/branch, with MOCK providers only. Never point BETA at the
# production database. Copy to .env.beta (git-ignored via .env*) and fill in;
# server values go to the BETA Supabase project with `npx supabase secrets set`.
# Anything prefixed VITE_ is public (bundled into the browser).
# ============================================================================

APP_ENV=staging
VITE_APP_ENV=staging
VITE_DEFAULT_CITY=riyadh
VITE_DEFAULT_LOCALE=ar

# ── Supabase: the BETA project ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://<beta-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<beta anon/publishable key>
SUPABASE_PROJECT_REF=<beta-project-ref>
BETA_PROJECT_REF=<beta-project-ref>     # build-only (never bundled): the build fails unless VITE_SUPABASE_URL is this project
SUPABASE_SERVICE_ROLE_KEY=            # server / CI only
VITE_AUTH_OTP_LENGTH=6                # = Auth → Phone → OTP length

# ── Maps (optional; without keys the built-in Riyadh map is used) ───────────
VITE_MAPS_PROVIDER=google             # google | mock
VITE_GOOGLE_MAPS_API_KEY=             # restricted to the BETA domain + Maps JS / Places / Geocoding
VITE_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_KEY=               # Routes API, different key from the browser key

# ── Payments / payouts / Wasl: MOCK ONLY ───────────────────────────────────
# BETA never talks to Moyasar, a bank or Elm (docs/beta/BETA_SECURITY.md). Do NOT add any
# MOYASAR_* / VITE_MOYASAR_* / WASL_APP_* value here: preflight blocks it and the Edge
# Functions refuse to run. Moyasar / Elm are verified later in a separate reviewed change.
PAYMENT_PROVIDER=mock
VITE_PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_URL=https://<beta-domain>/#/passenger
PAYOUT_PROVIDER=mock

WASL_MODE=mock

# ── Worker / health secrets: each different, ≥ 32 random characters ────────
#   openssl rand -hex 32
PAYMENTS_CRON_SECRET=
WASL_CRON_SECRET=
PRIVACY_CRON_SECRET=
HEALTH_SECRET=
